generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppSource {
  SIENGE
  WHATSAPP
  SYSTEM
}
enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}
enum InstallmentStatus {
  OPEN
  PAID
  CANCELED
  PARTIAL
  UNKNOWN
}
enum PaymentSlipStatus {
  UNKNOWN
  CONFIRMED
  REJECTED
}
enum MessageStatus {
  SCHEDULED
  QUEUED
  DRY_RUN
  SENT
  DELIVERED
  READ
  FAILED
  CANCELED
}
enum MessageChannel {
  WHATSAPP
}

model Customer {
  id          String          @id @default(cuid())
  siengeId    Int             @unique
  name        String
  taxId       String?
  active      Boolean         @default(true)
  phones      CustomerPhone[]
  contracts   Contract[]
  installments Installment[]
  pauses      CollectionPause[]
  messages    Message[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CustomerPhone {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  numberE164  String
  whatsappOptIn Boolean @default(false)
  active      Boolean  @default(true)
  preferred   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([customerId, numberE164])
}

model Project {
  id                 String @id @default(cuid())
  siengeCostCenterId Int    @unique
  name               String
  units              Unit[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Unit {
  id          String @id @default(cuid())
  siengeUnitId Int   @unique
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  name        String
  contracts   Contract[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contract {
  id                    String @id @default(cuid())
  siengeSalesContractId Int    @unique
  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id])
  unitId                String?
  unit                  Unit? @relation(fields: [unitId], references: [id])
  active                Boolean @default(true)
  installments          Installment[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Installment {
  id                      String @id @default(cuid())
  siengeReceivableBillId  Int
  siengeInstallmentId     Int
  customerId              String
  customer                Customer @relation(fields: [customerId], references: [id])
  contractId              String?
  contract                Contract? @relation(fields: [contractId], references: [id])
  dueDate                 DateTime
  originalAmount          Decimal @db.Decimal(18,2)
  currentAmount           Decimal? @db.Decimal(18,2)
  status                   InstallmentStatus @default(UNKNOWN)
  paymentSlipStatus        PaymentSlipStatus @default(UNKNOWN)
  partialPaymentDetected   Boolean @default(false)
  lastValidatedAt          DateTime?
  messages                 Message[]
  pauses                   CollectionPause[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  @@unique([siengeReceivableBillId, siengeInstallmentId])
  @@index([dueDate, status])
}

model CollectionRule {
  id             String @id @default(cuid())
  name           String @unique
  dayOffset      Int
  templateName   String
  languageCode   String @default("pt_BR")
  enabled        Boolean @default(false)
  sendHour       Int @default(9)
  excludePartial Boolean @default(true)
  messages       Message[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CollectionPause {
  id            String @id @default(cuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  until         DateTime
  reason        String
  createdAt     DateTime @default(now())
  @@index([customerId, until])
  @@index([installmentId, until])
}

model Message {
  id                String @id @default(cuid())
  channel           MessageChannel @default(WHATSAPP)
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  installmentId     String?
  installment       Installment? @relation(fields: [installmentId], references: [id])
  ruleId            String?
  rule              CollectionRule? @relation(fields: [ruleId], references: [id])
  phone             String
  templateName      String
  languageCode      String @default("pt_BR")
  scheduledAt       DateTime
  sentAt            DateTime?
  externalMessageId String? @unique
  status            MessageStatus @default(SCHEDULED)
  dedupeKey         String @unique
  payload           Json?
  lastError         String?
  events            MessageEvent[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([scheduledAt, status])
}

model MessageEvent {
  id                String @id @default(cuid())
  messageId         String?
  message           Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  externalMessageId String?
  status            String
  payload           Json
  occurredAt        DateTime
  createdAt         DateTime @default(now())
  @@index([externalMessageId])
}

model IntegrationEvent {
  id          String @id @default(cuid())
  source      AppSource
  externalId  String
  eventName   String
  status      IntegrationEventStatus @default(RECEIVED)
  tenant      String?
  headers     Json?
  payload     Json
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([source, externalId])
  @@index([status, createdAt])
}
