# App
APP_MODE=staging
APP_URL=http://localhost:3000
TIMEZONE=America/Maceio
DASHBOARD_BASIC_USER=admin
DASHBOARD_BASIC_PASS=CHANGE_ME
CRON_SECRET=CHANGE_ME

# MASTER SAFETY SWITCHES — keep these values in staging
OUTBOUND_MESSAGING_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_ALLOW_ALL_PRODUCTION=false
WHATSAPP_ALLOWLIST=+5582999999999

# Railway PostgreSQL / Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casaforte
REDIS_URL=redis://localhost:6379

# Sienge
SIENGE_SUBDOMAIN=SEU_SUBDOMINIO
SIENGE_USERNAME=SEU_USUARIO_API
SIENGE_PASSWORD=SUA_SENHA_API
# Put a long random token in the registered webhook URL: /api/webhooks/sienge?token=...
SIENGE_WEBHOOK_TOKEN=CHANGE_ME_LONG_RANDOM

# Meta WhatsApp Cloud API
# Keep version explicit so upgrades are intentional, not silent.
META_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_LONG_RANDOM
WHATSAPP_APP_SECRET=

# Approved template names in WhatsApp Manager
WA_TEMPLATE_D_MINUS_3=cf_cobranca_d_menos_3
WA_TEMPLATE_DUE_TODAY=cf_cobranca_vence_hoje
WA_TEMPLATE_D_PLUS_3=cf_cobranca_d_mais_3
WA_TEMPLATE_D_PLUS_7=cf_cobranca_d_mais_7
WA_TEMPLATE_LANGUAGE=pt_BR
